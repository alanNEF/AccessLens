{
  "name": "accesslens",
  "description": "An accessibility simulator for developers.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "test:phase0": "node tests/e2e/phase1.mjs",
    "test:phase1": "node tests/e2e/phase1.mjs",
    "test:phase2": "node --test tests/unit/simulator-controller.test.mjs && node tests/e2e/phase1.mjs",
    "test:phase3": "node --test tests/unit/simulator-controller.test.mjs && node tests/e2e/phase1.mjs",
    "test:phase4": "node --test tests/unit/simulator-controller.test.mjs && ACCESSLENS_CROSS_SITE=1 node tests/e2e/phase1.mjs",
    "demo": "python3 -m http.server 8081 --bind 127.0.0.1 --directory demo-site",
    "postinstall": "wxt prepare",
    "test:unit": "node --test tests/unit/*.test.mjs"
  },
  "dependencies": {
    "axe-core": "^4.14.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.73.0",
    "radix-ui": "^1.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@wxt-dev/module-react": "^1.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.0.0",
    "wxt": "^0.20.0"
  }
}
